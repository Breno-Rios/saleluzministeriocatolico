# Hosts allowed to reach the Next.js dev server's HMR/static assets
# (needed when testing on a phone or another device on the same network).
# Comma-separated, no spaces needed. Update with your current LAN IP.
NEXT_DEV_ALLOWED_ORIGINS=

# Vercel Blob read/write token, used by /api/folheto to serve the current
# "Folheto do Dia" PDF without needing a redeploy when it's replaced.
# In production/preview on Vercel this is set automatically once a Blob
# store is connected to the project. For local dev, run `vercel env pull`
# or copy the token from Vercel dashboard -> Storage -> your Blob store.
BLOB_READ_WRITE_TOKEN=
