# Hosts allowed to reach the Next.js dev server's HMR/static assets
# (needed when testing on a phone or another device on the same network).
# Comma-separated, no spaces needed. Update with your current LAN IP.
NEXT_DEV_ALLOWED_ORIGINS=

# Vercel Blob read/write token, used by /api/folheto to serve the current
# "Folheto do Dia" PDF without needing a redeploy when it's replaced.
# In production/preview on Vercel this is set automatically once a Blob
# store is connected to the project. For local dev, run `vercel env pull`
# or copy the token from Vercel dashboard -> Storage -> your Blob store.
BLOB_READ_WRITE_TOKEN=

# Password required at /admin to upload a new "Folheto do Dia" PDF
# (src/app/api/folheto/upload/route.ts). Anyone with this password can
# replace the PDF without needing a Vercel account or project access -
# share it only with whoever is responsible for the weekly folheto.
FOLHETO_UPLOAD_PASSWORD=

# Pre-launch gate (src/proxy.ts). While set, every page except
# /em-breve shows a "coming soon" screen with a password form; visitors
# who enter SITE_PREVIEW_PASSWORD get a cookie that skips the gate.
# The gate automatically stops applying once SITE_LAUNCH_AT is reached -
# leave both unset to keep the site fully public (no gate at all).
# Example: SITE_LAUNCH_AT=2026-09-15T00:00:00-03:00
SITE_LAUNCH_AT=
SITE_PREVIEW_PASSWORD=
