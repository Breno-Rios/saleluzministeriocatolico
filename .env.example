# Public production URL, used to build absolute URLs in sitemap.xml and
# robots.txt (src/lib/site.ts). Falls back to saleluzministeriocatolico.com.br
# when unset, so this only needs to be set if the domain changes.
NEXT_PUBLIC_SITE_URL=

# Hosts allowed to reach the Next.js dev server's HMR/static assets
# (needed when testing on a phone or another device on the same network).
# Comma-separated, no spaces needed. Update with your current LAN IP.
NEXT_DEV_ALLOWED_ORIGINS=

# Vercel Blob read/write token, used by /api/folheto to serve the current
# "Folheto do Dia" PDF without needing a redeploy when it's replaced.
# In production/preview on Vercel this is set automatically once a Blob
# store is connected to the project. For local dev, run `vercel env pull`
# or copy the token from Vercel dashboard -> Storage -> your Blob store.
BLOB_READ_WRITE_TOKEN=

# Google OAuth client ID for the /admin sign-in button. Create one at
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client
# ID -> Web application, and list the site's origins under "Authorized
# JavaScript origins". Public by design: it ships in the page's HTML.
# Leave it empty in development to get the local sign-in shortcut instead.
# See docs/admin-login.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Who may sign in to /admin, comma-separated. Google proves who the person
# is; this decides whether that person can publish. An address removed here
# loses access on its next request, without waiting for the session to expire.
ADMIN_EMAILS=

# Secret used to sign the /admin session cookie. Generate with
# `openssl rand -base64 32`. Required in production - without it the server
# refuses to open a session rather than issuing an unsigned one. In
# development a fixed fallback is used, so it only needs to be set to keep
# local sessions alive across restarts.
ADMIN_SESSION_SECRET=

# Resend API key, used by /api/contato to email orçamento requests from
# the Contato form. Get one for free at resend.com. Until a sending
# domain is verified there, Resend's sandbox sender
# (onboarding@resend.dev) can only deliver to the email address the
# Resend account itself was created with.
RESEND_API_KEY=

# Where orçamento requests from the Contato form are sent. Comma-separated
# for more than one recipient, e.g. a@x.com,b@x.com (no spaces needed).
CONTACT_EMAIL=
